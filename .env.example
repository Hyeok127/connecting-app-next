# .env.example — 실제 값을 넣어 .env.local로 복사한다 (`.env*`는 gitignore 대상).
#
#   cp .env.example .env.local
#
# ⚠️ 로컬 개발이 곧 원격 DB 조작이다. 로컬 DB도 SSH 터널도 없고, URL만으로 조용히 붙는다.
#    개발 DB(vnwkxkopnpyhabjfclpb)를 보고 있는지 항상 확인할 것.

# ── 필수 ──

# Supabase Project URL — Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# service_role 키 — RLS를 우회하는 전권 키. **서버 코드에서만** 쓴다. 절대 노출 금지.
# Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron 인증용. 생성: openssl rand -hex 16
CRON_SECRET=

# ── 선택 ──

# 사진 저장소 Cloudflare R2. 넷 다 있으면 R2를 쓰고, 없으면 Supabase Storage로 폴백한다.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# 이메일 알림(Resend). 없으면 조용히 건너뛴다 — 현재 휴면 상태.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=

# ── 운영 도구용 (앱 런타임에는 불필요) ──

# Supabase Management API 개인 액세스 토큰(sbp_...). 마이그레이션 적용에 쓴다.
# 모든 Supabase 프로젝트를 관리할 수 있는 전권 토큰이다 — 취급 주의.
# scripts/apply_migration.mjs, scripts/sql.mjs, scripts/inspect_db.mjs
SUPABASE_ACCESS_TOKEN=

# Vercel API 토큰. 환경변수 등록·배포 조작에 쓴다.
# scripts/vercel_env.mjs, scripts/check_preview_env.mjs
VERCEL_TOKEN=
